@@ -260,6 +285,7 @@
 static BOOL GFOSKeyUp(BOOL *keyTable, int k)
 {
     if (k < 0 || k >= NUM_KEYS) return NO;
+    sGFOSHeld[k] = NO;
     if (sGFOSDownThisPoll[k]) { sGFOSReleaseNext[k] = YES; return YES; }
     keyTable[k] = NO;
