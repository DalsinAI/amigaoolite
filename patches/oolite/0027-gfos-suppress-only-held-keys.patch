  * held to the start of the next poll, so every tap is seen for one tick. */
 static BOOL sGFOSDownThisPoll[NUM_KEYS];
 static BOOL sGFOSReleaseNext[NUM_KEYS];
+static BOOL sGFOSHeld[NUM_KEYS];   /* down on the keyboard now: key-down seen, key-up not yet */
 
