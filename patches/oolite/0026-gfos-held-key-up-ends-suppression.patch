+/* Returns YES when a held-over release was applied: that is when its key-up
+ * counts, for suppressKeysUntilKeyUp too (a screen change in the tick between
+ * must not be left waiting for a key-up that already went by). */
+static BOOL GFOSStartPoll(BOOL *keyTable)
 {
     int i;
+    BOOL released = NO;
     for (i = 0; i < NUM_KEYS; i++) {
         if (sGFOSReleaseNext[i]) {
             keyTable[i] = NO;
             sGFOSReleaseNext[i] = NO;
+            released = YES;
         }
         sGFOSDownThisPoll[i] = NO;
     }
+    return released;
 }
 
