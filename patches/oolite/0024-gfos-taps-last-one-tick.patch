+#if OOLITE_GFOS
+/* GFOS: the game reads key and button state once per tick; on a 68040 a
+ * tap's press and release can both arrive between two ticks and the game
+ * never sees it. A release that comes in the same poll as its press is
+ * held to the start of the next poll, so every tap is seen for one tick. */
+static BOOL sGFOSDownThisPoll[NUM_KEYS];
+static BOOL sGFOSReleaseNext[NUM_KEYS];
+
+static void GFOSStartPoll(BOOL *keyTable)
+{
+    int i;
+    for (i = 0; i < NUM_KEYS; i++) {
+        if (sGFOSReleaseNext[i]) {
+            keyTable[i] = NO;
+            sGFOSReleaseNext[i] = NO;
+        }
+        sGFOSDownThisPoll[i] = NO;
+    }
+}
+
+static void GFOSKeyDown(BOOL *keyTable, int k)
+{
+    if (k < 0 || k >= NUM_KEYS) return;
+    keyTable[k] = YES;
+    sGFOSDownThisPoll[k] = YES;
+    sGFOSReleaseNext[k] = NO;
+}
+
+static void GFOSKeyUp(BOOL *keyTable, int k)
+{
+    if (k < 0 || k >= NUM_KEYS) return;
+    if (sGFOSDownThisPoll[k]) sGFOSReleaseNext[k] = YES;
+    else keyTable[k] = NO;
+}
+#endif
+
